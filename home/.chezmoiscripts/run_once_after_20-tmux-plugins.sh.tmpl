{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Installs tpm and the tmux plugins listed in tmux.conf (once per machine).
set -eu

command -v tmux >/dev/null 2>&1 || { echo "tmux-plugins: tmux is not installed, skipping"; exit 0; }

TPM="$HOME/.config/tmux/plugins/tpm"
if [ ! -d "$TPM" ]; then
    git clone --depth 1 https://github.com/tmux-plugins/tpm "$TPM"
fi
"$TPM/bin/install_plugins" || echo "tmux-plugins: install failed; press prefix + I inside tmux"
{{ end -}}
